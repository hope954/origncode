PORT=3000
DATA_FILE=./data/store.json
# 32-byte base64 key preferred; dev fallback exists but replace in real deployment.
TOKEN_ENCRYPTION_KEY=change_me_for_prod

# ── Stage 4 Feishu real integration ─────────────────────────────────────────
# Set FEISHU_APP_ID + FEISHU_APP_SECRET to enable real OAuth/token exchange/refresh.
# When unset, auth_service uses a synthesised token (CI/dev mock path).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://your-domain/callback/feishu
# Optional override for private-region or API-gateway scenarios
FEISHU_BASE_URL=https://open.feishu.cn

# ── Stage 4 Yuque real integration ──────────────────────────────────────────
# YUQUE_LIVE_VERIFY=1  → verifyYuqueToken probes GET /api/v2/user (real HTTP)
# YUQUE_LIVE_FETCH=1   → YuqueAdapter.fetchDocument calls real /api/v2/repos/...
# Both default to off (structural-only check + mock content) for CI safety.
YUQUE_BASE_URL=https://www.yuque.com
# YUQUE_LIVE_VERIFY=1
# YUQUE_LIVE_FETCH=1
